# ===== Configuration du lanceur 5G (modifiez seulement ce fichier) =====

# Mode du RAN : "virtual" = coeur 5G + gNB RFsim + UE logiciel, sans radio physique.
# "auto" = "usrp" si la B210 est détectée, sinon "virtual".
# "usrp" = vraie radio B210 + modem physique Quectel.
RAN_MODE="virtual"

# IMSI de la SIM, utilisé si le modem n'est pas lisible (mode virtual). Vide = lecture automatique dans le modem.
SIM_IMSI=""

# Utilisateur de CETTE machine utilisé par l'orchestrateur (SSH + sudo)
ORCH_USER="drame-kandji"

# Adresse IP de cette machine (vide = détection automatique)
NODE_IP=""

# Dossier qdong (contient qhat-init et stop.sh)
QDONG_DIR="/home/drame-kandji/Etudes/Collaborations/Hackathon/Summer School EPT/qdong"

# DNN / APN du modem
DNN="internet"

# Moitié de bande n78 : 1 = 3610-3630 MHz, 2 = 3630-3650 MHz (celle attribuée à votre équipe)
BAND_HALF=1

# Réglages de la USRP B210. Si le modem et l'USRP sont très proches (moins de 1 m),
# baissez TX_GAIN_DB (par exemple 20) pour éviter de saturer le récepteur du modem.
TX_GAIN_DB=35
RX_GAIN_DB=114
TX_ATT_DB=10
RX_ATT_DB=10

# Clés de la SIM (valeurs des SIM de l'exemple des organisateurs). L'IMSI, lui, est lu automatiquement dans le modem.
SIM_K="fec86ba6eb707ed08905757b1bb44b8f"
SIM_OPC="C42449363BBAD02B66D16BC975D77CC1"

# Nombre de chiffres du MNC (2 pour 001/01)
MNC_LEN=2

# Source de l'orchestrateur : vide = installation depuis le GitLab d'Inria,
# ou chemin d'un dépôt orchestrator déjà cloné sur cette machine
ORCH_SOURCE=""

# Port AT du modem (vide = détection automatique)
AT_PORT=""

# Doit rester "true" : l'orchestrateur ignore les machines marquées "false" (voir README). Il installe lui-même Kubernetes.
NODE_PROVISIONED="true"

# Point d'accès Wi-Fi : les clients sortent par l'interface de l'UE 5G virtuelle.
# WIFI_AP_PARENT doit être une carte autorisant le mode AP en parallèle du mode client.
WIFI_AP_ENABLE="true"
WIFI_AP_PARENT="wlp2s0"
WIFI_AP_IFACE="ap5g0"
WIFI_AP_SSID="EPT-5G"
WIFI_AP_PSK=""
WIFI_AP_COUNTRY="FR"
WIFI_AP_SUBNET="192.168.50.0/24"
WIFI_AP_HOST_IP="192.168.50.1"
WIFI_AP_UPSTREAM="oaitun_ue1"
